# ==========================================
# Configuración de Correo - The Pale Blue Dot
# ==========================================

# Correo donde recibirás los mensajes de contacto
RECIPIENT_EMAIL=pato.geojimenez@gmail.com

# Configuración SMTP (por defecto Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=pato.geojimenez@gmail.com

# Contraseña de aplicación de Google (16 caracteres)
# Generar en: https://myaccount.google.com/apppasswords
# (Cuenta Google -> Seguridad -> Verificación en dos pasos -> Contraseñas de aplicaciones)
SMTP_PASSWORD=

